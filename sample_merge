import duckdb
import pandas as pd
import time

# =============================================================================
# SMALL SAMPLE TEST CONFIGURATION
# =============================================================================
TEST_YEAR = 2020  # Single year for testing
DATASET_TYPE = "COMMERCIAL_SET_A"
DATABASE = "CCAE"
SAMPLE_PERCENT = 1  # Use 1% sample

print("SMALL SAMPLE TEST - STEPS 1 AND 2")
print("="*60)
print(f"Year: {TEST_YEAR}")
print(f"Sample size: {SAMPLE_PERCENT}%")
print(f"Goal: Prove workflow works and estimate timing")
print("="*60)

def test_workflow_small_sample():
    """Test the workflow with a tiny sample"""
    
    # File paths
    d_file = f"/data/MarketScan_data/{DATASET_TYPE}/{DATABASE}_D_{TEST_YEAR}.parquet"
    o_file = f"/data/MarketScan_data/{DATASET_TYPE}/{DATABASE}_O_{TEST_YEAR}.parquet"
    
    total_start_time = time.time()
    
    # =============================================================================
    # STEP 1: Sample from D file, keep only needed columns
    # =============================================================================
    print("\nSTEP 1: Sampling prescription file...")
    step1_start = time.time()
    
    # Get 1% sample from D file, keep only ENROLID, SVCDATE
    print(f"  Getting {SAMPLE_PERCENT}% sample from D file (ENROLID, SVCDATE only)...")
    conn.execute(f"""
        CREATE OR REPLACE TABLE sampled_prescriptions AS
        SELECT DISTINCT ENROLID, SVCDATE
        FROM '{d_file}'
        USING SAMPLE {SAMPLE_PERCENT} PERCENT
    """)
    
    prescription_count = conn.execute("SELECT COUNT(*) FROM sampled_prescriptions").fetchone()[0]
    unique_patients = conn.execute("SELECT COUNT(DISTINCT ENROLID) FROM sampled_prescriptions").fetchone()[0]
    
    print(f"  Sample results: {prescription_count:,} prescriptions from {unique_patients:,} patients")
    print(f"  Step 1 completed in {time.time() - step1_start:.2f} seconds")
    
    # =============================================================================
    # STEP 2: Process Physician File and Join (SAMPLED)
    # =============================================================================
    print("\nSTEP 2: Processing physician file and joining...")
    step2_start = time.time()
    
    # Get sampled physician data for the same patients
    print(f"  Getting physician visits for the SAME sampled patients...")
    conn.execute(f"""
        CREATE OR REPLACE TABLE sampled_visits AS
        SELECT DISTINCT o.ENROLID, o.SVCDATE, o.NPI
        FROM '{o_file}' o
        INNER JOIN common_patients c ON o.ENROLID = c.ENROLID
    """)
    
    visit_count = conn.execute("SELECT COUNT(*) FROM sampled_visits").fetchone()[0]
    print(f"  Found {visit_count:,} visits for sampled patients")
    
    # Perform the join with ±3 days
    print(f"  Performing ±3 days join...")
    join_start = time.time()
    
    conn.execute(f"""
        CREATE OR REPLACE TABLE npi_counts AS
        SELECT 
            p.ENROLID,
            p.SVCDATE as original_svcdate,
            COALESCE(COUNT(DISTINCT o.NPI), 0) as unique_npis
        FROM sampled_prescriptions p
        LEFT JOIN sampled_visits o 
        ON p.ENROLID = o.ENROLID 
        AND o.SVCDATE BETWEEN (p.SVCDATE - INTERVAL 3 DAY) 
                          AND (p.SVCDATE + INTERVAL 3 DAY)
        GROUP BY p.ENROLID, p.SVCDATE
    """)
    
    npi_count_records = conn.execute("SELECT COUNT(*) FROM npi_counts").fetchone()[0]
    print(f"  Join completed in {time.time() - join_start:.2f} seconds")
    print(f"  Result: {npi_count_records:,} prescription-NPI count records")
    print(f"  Step 2 completed in {time.time() - step2_start:.2f} seconds")
    
    # =============================================================================
    # CREATE HISTOGRAM
    # =============================================================================
    print("\nCreating NPI count histogram...")
    histogram_start = time.time()
    
    histogram_data = conn.execute("""
        SELECT 
            unique_npis,
            COUNT(*) as patient_date_count,
            COUNT(*) * 100.0 / SUM(COUNT(*)) OVER() as percentage
        FROM npi_counts
        GROUP BY unique_npis
        ORDER BY unique_npis
    """).df()
    
    print("NPI Count Histogram (Sample):")
    print(histogram_data.to_string(index=False))
    
    # Save sample results
    histogram_data.to_csv(f"/home/zl749/sample_histogram_{TEST_YEAR}.csv", index=False)
    
    # Get unique NPI cases
    unique_npi_count = conn.execute("SELECT COUNT(*) FROM npi_counts WHERE unique_npis = 1").fetchone()[0]
    unique_npi_pct = unique_npi_count / npi_count_records * 100 if npi_count_records > 0 else 0
    
    print(f"Cases with exactly 1 NPI: {unique_npi_count:,} ({unique_npi_pct:.1f}%)")
    
    # Save unique NPI cases
    conn.execute(f"""
        COPY (
            SELECT ENROLID, original_svcdate
            FROM npi_counts
            WHERE unique_npis = 1
        ) TO '/home/zl749/sample_unique_npi_{TEST_YEAR}.csv' (FORMAT 'csv', HEADER)
    """)
    
    print(f"Histogram creation completed in {time.time() - histogram_start:.2f} seconds")
    
    # =============================================================================
    # EXTRAPOLATION ESTIMATES
    # =============================================================================
    total_time = time.time() - total_start_time
    
    print(f"\n{'='*60}")
    print("SAMPLE TEST RESULTS & EXTRAPOLATION")
    print(f"{'='*60}")
    print(f"Sample processing time: {total_time:.2f} seconds")
    print(f"Sample size: {SAMPLE_PERCENT}%")
    
    # Extrapolate to full data
    full_data_time = total_time / (SAMPLE_PERCENT / 100)
    print(f"Estimated full data time: {full_data_time:.1f} seconds ({full_data_time/60:.1f} minutes)")
    
    # Per year estimates
    print(f"Estimated time per year: {full_data_time/60:.1f} minutes")
    
    # Multi-year estimates
    years_to_process = 8  # 2017-2024
    total_estimated_time = full_data_time * years_to_process / 3600  # Convert to hours
    print(f"Estimated total time for {years_to_process} years: {total_estimated_time:.1f} hours")
    
    # Data quality assessment
    print(f"\nData Quality Assessment:")
    print(f"  Total prescriptions in sample: {prescription_count:,}")
    print(f"  Prescriptions with NPI assignments: {unique_npi_count:,}")
    print(f"  Assignment rate: {unique_npi_pct:.1f}%")
    
    if unique_npi_pct > 30:
        print("  ✅ Good assignment rate - workflow is viable")
    elif unique_npi_pct > 10:
        print("  ⚠️  Moderate assignment rate - may still be useful")
    else:
        print("  ❌ Low assignment rate - may need to reconsider approach")
    
    # Feasibility assessment
    if total_estimated_time < 2:
        print("\n✅ FEASIBLE: Processing time is reasonable")
        print("   Recommend proceeding with full dataset")
    elif total_estimated_time < 8:
        print("\n⚠️  BORDERLINE: Processing time is long but manageable")
        print("   Recommend overnight processing or larger samples")
    else:
        print("\n❌ NOT FEASIBLE: Processing time too long")
        print("   Recommend larger samples (1-5%) or different approach")
    
    print(f"\nSample files created:")
    print(f"  /home/zl749/sample_histogram_{TEST_YEAR}.csv")
    print(f"  /home/zl749/sample_unique_npi_{TEST_YEAR}.csv")
    
    # Clean up
    conn.execute("DROP TABLE sampled_prescriptions")
    conn.execute("DROP TABLE sampled_visits")
    conn.execute("DROP TABLE npi_counts")
    
    return total_time, unique_npi_pct, full_data_time

# =============================================================================
# MAIN EXECUTION
# =============================================================================

# Connect with moderate settings
conn = duckdb.connect()
conn.execute("SET memory_limit='4GB'")
conn.execute("SET threads=4")

try:
    sample_time, assignment_rate, estimated_full_time = test_workflow_small_sample()
    
    print(f"\n{'='*60}")
    print("FINAL RECOMMENDATION")
    print(f"{'='*60}")
    
    if estimated_full_time < 300:  # < 5 minutes
        print("✅ PROCEED with full dataset - timing looks great!")
        print("   Estimated full processing: <5 minutes per year")
    elif estimated_full_time < 1800:  # < 30 minutes  
        print("✅ PROCEED with full dataset - timing acceptable")
        print(f"   Estimated full processing: {estimated_full_time/60:.1f} minutes per year")
    else:
        print("⚠️  CONSIDER larger sample test first")
        print(f"   Current estimate: {estimated_full_time/60:.1f} minutes per year")
        print("   Try 1% sample next if this looks promising")
    
    if assignment_rate > 40:
        print("✅ Excellent assignment rate - analysis will be very useful")
    elif assignment_rate > 20:
        print("✅ Good assignment rate - analysis will be useful")  
    else:
        print("⚠️  Low assignment rate - results may be limited")

except Exception as e:
    print(f"ERROR in sample test: {e}")

finally:
    conn.close()

print("\nSample test completed!")
